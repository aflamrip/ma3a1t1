---
import Layout from '../layouts/Layout.astro';
import { getDynamicContent, CDN_URLS, getPrefix } from '../lib/constants';

interface Props {
  message?: string;
}

const { message = 'عذراً، الفيلم أو المسلسل المطلوب غير موجود أو تم حذفه.' } = Astro.props;

// Explicitly set real HTTP 404 status code and prevent caching missing items
Astro.response.status = 404;
Astro.response.statusText = 'Not Found';
Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate');

let suggestions: any[] = [];
try {
  const [allMovies, allSeries] = await Promise.all([
    getDynamicContent('movie', 1),
    getDynamicContent('tv', 1),
  ]);
  suggestions = [
    ...allMovies.slice(0, 3),
    ...allSeries.slice(0, 3),
  ].sort(() => Math.random() - 0.5);
} catch (e) {
  suggestions = [];
}
---

<Layout title="الصفحة غير موجودة - 404 | معاك سيما" noindex={true}>
  <div class="space-y-16 py-12 px-4 max-w-7xl mx-auto">
    
    <!-- Hero Error Section -->
    <div class="flex flex-col items-center justify-center text-center space-y-8 bg-zinc-900/20 py-12 rounded-[40px] border border-zinc-800 shadow-3xl relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-red-500/10 via-transparent to-amber-500/5 -z-10 blur-3xl"></div>
      
      <div class="relative group">
        <h1 class="text-[120px] md:text-[140px] leading-none font-black bg-clip-text text-transparent bg-gradient-to-tr from-white via-red-500 to-amber-400 drop-shadow-2xl opacity-90 pb-2">
          404
        </h1>
        <div class="absolute -inset-10 blur-3xl bg-red-500/20 rounded-full -z-10 animate-pulse"></div>
      </div>
      
      <div class="space-y-4 max-w-2xl">
        <h2 class="text-3xl md:text-4xl text-zinc-100 font-black tracking-tight leading-normal">
          {message}
        </h2>
        <p class="text-zinc-400 max-w-xl mx-auto text-base md:text-lg font-medium leading-relaxed pt-2">
          لا تقلق، قد يكون الرابط خاطئاً أو تم تحديثه. ابحث عما تفضله باستخدام محرك البحث أو استكشف مقترحاتنا بالأسفل.
        </p>
      </div>
      
      <!-- Search Bar -->
      <div class="w-full max-w-3xl mx-auto pt-6 px-4">
         <form action="/movie" method="GET" class="relative group">
            <input 
              type="text" 
              name="q" 
              placeholder="ابحث عن الأفلام أو المسلسلات..."
              class="w-full bg-zinc-900 border-2 border-zinc-700/80 rounded-[28px] py-5 pr-16 pl-6 text-white outline-none focus:border-primary focus:ring-8 focus:ring-primary/10 transition placeholder:text-zinc-500 font-bold text-lg shadow-2xl"
            />
            <div class="absolute right-6 top-1/2 -translate-y-1/2 text-zinc-500 group-focus-within:text-primary transition-colors">
               <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </div>
            <button type="submit" class="absolute left-4 top-1/2 -translate-y-1/2 bg-zinc-800 hover:bg-primary text-zinc-300 hover:text-white px-6 py-2.5 rounded-2xl font-black text-sm transition border border-zinc-700">بحث</button>
         </form>
      </div>
    </div>

    <!-- Suggestions Section -->
    {suggestions.length > 0 && (
      <section class="space-y-8">
        <div class="flex justify-between items-center px-2">
           <h3 class="text-2xl font-black text-white flex items-center gap-3">
             <span class="w-3 h-3 bg-amber-500 rounded-full"></span>
             مقترحات تصفح أخرى
           </h3>
           <a href="/" class="px-5 py-2 bg-zinc-900 border border-zinc-800 text-zinc-400 hover:text-white transition rounded-xl text-sm font-bold">الرئيسية</a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-5">
          {suggestions.map(item => {
            const isMovie = item.data.type === 'movie';
            const poster = `${CDN_URLS.POSTER}/${isMovie ? 'movies' : 'tv'}/${getPrefix(item.id)}/${item.id}/${item.id}.webp`;
            return (
              <a href={`/${isMovie ? 'movie' : 'tv'}/${item.data.slug}`} class="group relative block bg-zinc-900 rounded-xl overflow-hidden border border-zinc-800 hover:border-amber-500 transition aspect-[2/3]">
                 <img src={poster} alt={item.data.title} class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform" loading="lazy" />
                 <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-transparent to-transparent opacity-90"></div>
                 <div class="p-3 absolute bottom-0 right-0 left-0">
                    <h4 class="text-xs font-bold text-white group-hover:text-amber-400 truncate">{item.data.title}</h4>
                    <span class="text-[10px] text-zinc-400">{item.data.year}</span>
                 </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

  </div>
</Layout>
